{
  "name": "taksi-go-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "map:build": "npm run map:fetch && npm run map:glyphs && npm run map:tiles",
    "map:fetch": "python scripts/map/fetch_osm.py",
    "map:glyphs": "python scripts/map/make_glyphs.py",
    "map:tiles": "node scripts/map/build_tiles.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "geojson-vt": "^4.0.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vt-pbf": "^3.1.3"
  }
}
